rules_version = '2';
// ידיעת הארץ — חוקי אבטחה לטבלת הדירוג.
// users/{uid}      : כינוי + סיכום מצטבר (total, days, best, lastDate)
// names/{כינוי}    : שמירת כינוי ייחודי
// scores/{date_uid}: תוצאת אתגר יומי — אחת לכל שחקן ביום, בלי עריכה
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function validDate(d) {
      // תאריך היום (±יום, בגלל אזורי זמן) — אי אפשר לשלוח תוצאה לימים קודמים
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > timestamp.date(int(d.split('-')[0]), int(d.split('-')[1]), int(d.split('-')[2])) - duration.value(1, 'd')
        && request.time < timestamp.date(int(d.split('-')[0]), int(d.split('-')[1]), int(d.split('-')[2])) + duration.value(2, 'd');
    }

    match /names/{key} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key.size() >= 2 && key.size() <= 20;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'days', 'best', 'lastDate'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
        && getAfter(/databases/$(db)/documents/names/$(request.resource.data.name.lower())).data.uid == uid
        && request.resource.data.total == 0 && request.resource.data.days == 0
        && request.resource.data.best == 0 && request.resource.data.lastDate == '';
      // עדכון מותר רק יחד עם תוצאה יומית חדשה, ובדיוק בסכום שלה
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'days', 'best', 'lastDate'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.lastDate > resource.data.lastDate
        && request.resource.data.days == resource.data.days + 1
        && getAfter(/databases/$(db)/documents/scores/$(request.resource.data.lastDate + '_' + uid)).data.total
             == request.resource.data.total - resource.data.total
        && request.resource.data.best >= resource.data.best
        && request.resource.data.best >= request.resource.data.total - resource.data.total
        && (request.resource.data.best == resource.data.best
            || request.resource.data.best == request.resource.data.total - resource.data.total);
      allow delete: if false;
    }

    match /scores/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'total', 'res'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid
        && validDate(request.resource.data.date)
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 2000
        && request.resource.data.res is list && request.resource.data.res.size() == 20
        && request.resource.data.name == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.name;
      allow update, delete: if false;
    }
  }
}
